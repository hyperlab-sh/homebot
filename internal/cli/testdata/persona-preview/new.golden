schema = 1
id = "tester"
name = "tester"
emoji = "🧹"
tagline = ""
extends = "neatpik"

[colors]

[lines]
# "cli.error.args_hint" = ["See: {homebot}{command_space}{help}"]  # {command_space}: the command being run followed by a space, or empty for the inbox (string); {homebot}: the command word and space (fixed) (string); {help}: the help flag (fixed) (string)
