# "unpack.status.header" = ["Unpacking {profile} on {host} ({os}): {n} steps"]  # {profile}: a profile name (a file in manifests/profiles/ without .yml) (string); {host}: this machine's host name (string); {os}: linux or macos (the internal OS name, printed as is) (string); {n}: number of steps (int)
# "unpack.error.step_failed" = ["Step {i} failed: {message}"]  # {i}: 1-based position of the current item or step (int); {message}: the internal action's error: action.link.error.*, action.unlock.*, action.run.error.exit, secrets.error.* (string)
