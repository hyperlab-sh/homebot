config.error.profiles [error]: {file}: {profiles} must be a mapping {file}: path, path of the YAML file being read (homebot.yml, decisions.yml or a profile); {profiles}: string, the profiles config key (fixed), profiles
config.error.profiles_default [error]: {file}: {default_key} must be a profile name {file}: path, path of the YAML file being read (homebot.yml, decisions.yml or a profile); {default_key}: string, the default profile config key (fixed), profiles.default
config.error.profiles_hosts [error]: {file}: {hosts_key} must map host names to profile names {file}: path, path of the YAML file being read (homebot.yml, decisions.yml or a profile); {hosts_key}: string, the per-host profile config key (fixed), profiles.hosts
config.error.triage [error]: {file}: {triage} must be a mapping {file}: path, path of the YAML file being read (homebot.yml, decisions.yml or a profile); {triage}: string, the triage config key (fixed), triage
config.error.triage_watch [error]: {file}: {watch} entries end in {star} or {dot_star} (got "{value}") {file}: path, path of the YAML file being read (homebot.yml, decisions.yml or a profile); {value}: string, the watch entry given; {watch}: string, the watch config key (fixed), triage.watch; {star}: string, the folder glob suffix (fixed), /*; {dot_star}: string, the dotfile glob suffix (fixed), /.*
config.error.autosave [error]: {file}: {autosave} must be a mapping {file}: path, path of the YAML file being read (homebot.yml, decisions.yml or a profile); {autosave}: string, the autosave config key (fixed), autosave
config.error.autosave_commit [error]: {file}: {commit} must be {choices} {file}: path, path of the YAML file being read (homebot.yml, decisions.yml or a profile); {commit}: string, the autosave commit config key (fixed), autosave.commit; {choices}: string, the permitted autosave frequencies (fixed), off, hourly or daily
config.error.autosave_push [error]: {file}: {push} must be {boolean} {file}: path, path of the YAML file being read (homebot.yml, decisions.yml or a profile); {push}: string, the autosave push config key (fixed), autosave.push; {boolean}: string, the permitted boolean values (fixed), true or false
config.error.exports [error]: {file}: {exports} must be a list {file}: path, path of the YAML file being read (homebot.yml, decisions.yml or a profile); {exports}: string, the exports config key (fixed), exports
config.error.export_mapping [error]: {where}: expected a mapping with {keys} {where}: string, '{file}: exports[{i}]'; {keys}: string, the required export config keys (fixed), name, out, run
config.error.export_required [error]: {where}: {key_name} is required {where}: string, '{file}: exports[{i}]'; {key_name}: string, name, out or run
config.error.export_profiles [error]: {where}.{profiles}: expected a list of profile names {where}: string, '{file}: exports[{i}]'; {profiles}: string, the export profiles config key (fixed), profiles
config.error.export_duplicate [error]: {file}: {exports_open}{i}{exports_close}: duplicate export name "{name}" (give each one {profiles} that don't overlap) {file}: path, path of the YAML file being read (homebot.yml, decisions.yml or a profile); {i}: int, 1-based position of the current item or step; {name}: string, export name; {exports_open}: string, the export list key and opening bracket (fixed), exports[; {exports_close}: string, the export index closing bracket (fixed), ]; {profiles}: string, the export profiles key (fixed), profiles
config.error.export_out_absolute [error]: {where}: {out_key} {out} of export "{name}" is an absolute path; give a path inside the repo, relative to it {where}: string, '{file}:{line}:{col}: exports[{i}]', or 'homebot.yml export {name}' when the check runs after {os}, {host} and {arch} are filled in; {out}: string, the out value as written, or as filled in; {name}: string, export name; {out_key}: string, the export output key (fixed), out
config.error.export_out_outside [error]: {where}: {out_key} {out} of export "{name}" leads outside the repo {where}: string, as in config.error.export_out_absolute; {out}: string, the out value as written, or as filled in; {name}: string, export name; {out_key}: string, the export output key (fixed), out
config.error.export_out_root [error]: {where}: {out_key} {out} of export "{name}" is the repo itself; name a file or folder inside it {where}: string, as in config.error.export_out_absolute; {out}: string, the out value as written, or as filled in; {name}: string, export name; {out_key}: string, the export output key (fixed), out
config.error.export_out_git [error]: {where}: {out_key} {out} of export "{name}" is in {git_dir}, which belongs to git {where}: string, as in config.error.export_out_absolute; {out}: string, the out value as written, or as filled in; {name}: string, export name; {out_key}: string, the export output key (fixed), out; {git_dir}: string, the git metadata directory (fixed), .git
config.error.export_out_private [error]: {where}: {out_key} {out} of export "{name}" is in {private}, where your secrets are {where}: string, as in config.error.export_out_absolute; {out}: string, the out value as written, or as filled in; {name}: string, export name; {out_key}: string, the export output key (fixed), out; {private}: string, the private secrets directory (fixed), private/
config.error.export_out_managed [error]: {where}: {out_key} {out} of export "{name}" is {managed}, which homebot keeps for itself; put exports under {manifests} {where}: string, as in config.error.export_out_absolute; {out}: string, the out value as written, or as filled in; {name}: string, export name; {managed}: path, the managed path, repo-relative, as homebot names it (lower case); {out_key}: string, the export output key (fixed), out; {manifests}: string, the manifests directory (fixed), manifests/
config.error.export_out_managed_inside [error]: {where}: {out_key} {out} of export "{name}" is inside {managed}, which homebot keeps for itself; put exports under {manifests} {where}: string, as in config.error.export_out_absolute; {out}: string, the out value as written, or as filled in; {name}: string, export name; {managed}: path, the managed path, repo-relative, as homebot names it (lower case); {out_key}: string, the export output key (fixed), out; {manifests}: string, the manifests directory (fixed), manifests/
config.error.export_out_symlink [error]: {where}: {out_key} {out} of export "{name}" goes through a symlink to {target}, which is outside the repo, the repo itself, or a path homebot keeps for itself {where}: string, as in config.error.export_out_absolute; {out}: string, the out value as written, or as filled in; {name}: string, export name; {target}: path, the deepest folder of out that exists, with its symlinks resolved, absolute; {out_key}: string, the export output key (fixed), out
