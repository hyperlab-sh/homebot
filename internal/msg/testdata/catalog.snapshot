git.identity_fix
  "mkdir -p ~/.config/git && git config --file ~/.config/git/config user.name \"Your Name\" && git config --file ~/.config/git/config user.email you@example.com"

git.signing_off
  "git config --file ~/.config/git/config.local commit.gpgsign false && git config --file ~/.config/git/config.local tag.gpgsign false"

git.gitconfig_aside
  "mv ~/.gitconfig ~/.gitconfig.homebot-backup-$(date +%Y%m%d-%H%M%S)"

