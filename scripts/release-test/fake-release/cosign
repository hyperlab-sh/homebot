#!/bin/sh
# Stub records argv and refuses any change to the install script's trust call.
case ${1:-} in
  version) printf 'GitVersion: %s\n' "${FAKE_COSIGN_VERSION:-v3.1.3}" ;;
  verify-blob)
    shift
    printf '%s\n' "$@" >"${FAKE_COSIGN_ARGS:?}"
    [ "${FAKE_COSIGN_FAIL:-0}" = 0 ] || exit 1
    ;;
  *) exit 1 ;;
esac
