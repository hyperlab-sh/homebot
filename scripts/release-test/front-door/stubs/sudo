#!/bin/bash
# Stub sudo: logs, then runs the command (the other stubs do the pretending).
echo "sudo $*" >>"${STUB_LOG:?}"
if [ "${1:-}" = -n ]; then shift; fi
if [ -n "${STUB_SUDO_FAIL:-}" ]; then
  echo "sudo: a password is required" >&2
  exit 1
fi
if [ "${1:-}" = -v ]; then exit 0; fi
exec "$@"
