[!linux] skip 'recorded on linux'

# Real files in the way: link reports them and leaves them alone (exit 0).
# exit: 0
exec homebot link
cmpwork stdout link-conflict.stdout
cmpwork stderr link-conflict.stderr
# exit: 0
exec homebot
cmpwork stdout link-conflict-inbox.stdout
# exit: 0
exec homebot link --dry-run
cmpwork stdout link-conflict-dry.stdout
