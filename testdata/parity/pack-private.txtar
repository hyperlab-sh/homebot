[!linux] skip 'recorded on linux'

# pack --private seals the file under private/ with age (recipients.txt is in the repo).
chmod 755 bin/gitleaks
chmod 755 bin/systemctl
exec git -C home/.home init -q
exec git -C home/.home add -A
exec git -C home/.home commit -q -m init
exec git init -q --bare remote.git
exec git -C home/.home remote add origin $WORK/remote.git
exec git -C home/.home push -q -u origin main
# exit: 0
exec homebot pack --private ~/.netrc
cmpwork stdout pack-private.stdout
cmpwork stderr pack-private.stderr
exists home/.home/private/common/netrc.age
exists home/.home/private/common/netrc
# exit: 0
exec homebot
# deliberate: triage skips private/ in the repo, since save stages it itself (recorded from bun src/cli.ts with the same skip)
cmpwork stdout inbox-after-private.stdout
# exit: 0
exec homebot lock --wipe
cmpwork stdout lock-wipe.stdout
