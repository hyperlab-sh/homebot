[!linux] skip 'recorded on linux'

# identity.age is not an age file: unlock stops before asking for a passphrase.
# exit: 1
! exec homebot unlock
cmpwork stdout unlock-placeholder.stdout
# deliberate: the TypeScript let the age CLI print its raw header error, then guessed "wrong passphrase?"; Go opens the file in-process, sees it is not a passphrase-encrypted age file before asking, and says so
cmpwork stderr unlock-placeholder.stderr
