[!linux] skip 'recorded on linux'

# lock and unlock with nothing to do.
# exit: 0
exec homebot lock
cmpwork stdout lock-nothing.stdout
cmpwork stderr lock-nothing.stderr
# exit: 0
exec homebot lock --wipe
cmpwork stdout lock-wipe-nothing.stdout
-- bin/gitleaks --
#!/bin/sh
exit 0
-- bin/systemctl --
#!/bin/sh
exit 0
-- home/.home/homebot.yml --
profiles:
  default: workstation
-- home/.home/manifests/profiles/workstation.yml --
description: A workstation
steps:
  - link
-- home/.home/private/.gitignore --
*
!*/
!*.age
!.gitignore
!README.md
!recipients.txt
!.gitkeep
