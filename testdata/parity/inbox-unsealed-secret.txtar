[!linux] skip 'recorded on linux'

# A plaintext secret that is not sealed yet; lock seals it with age.
chmod 755 bin/gitleaks
chmod 755 bin/systemctl
exec git -C home/.home init -q
exec git -C home/.home add -A
exec git -C home/.home commit -q -m init
exec git init -q --bare remote.git
exec git -C home/.home remote add origin $WORK/remote.git
exec git -C home/.home push -q -u origin main
# exit: 0
exec homebot setup
# exit: 0
exec homebot unpack
# exit: 0
exec homebot
cmpwork stdout inbox-clean-first.stdout
# deliberate: testscript's cp does not create the folder; the recorder's did
mkdir home/.home/private/common
cp secret.txt home/.home/private/common/api-token
# exit: 0
exec homebot
cmpwork stdout inbox-unsealed.stdout
cmpwork stderr inbox-unsealed.stderr
# exit: 0
exec homebot lock
cmpwork stdout lock.stdout
cmpwork stderr lock.stderr
exists home/.home/private/common/api-token.age
# exit: 0
exec homebot
# deliberate: triage skips private/ in the repo, since save stages it itself (recorded from bun src/cli.ts with the same skip)
cmpwork stdout inbox-after-lock.stdout
# exit: 0
exec homebot lock
cmpwork stdout lock-again.stdout
-- secret.txt --
token=abc123
-- bin/gitleaks --
#!/bin/sh
exit 0
-- bin/systemctl --
#!/bin/sh
exit 0
-- home/.home/homebot.yml --
profiles:
  default: workstation
-- home/.home/manifests/profiles/workstation.yml --
description: A workstation
steps:
  - link
-- home/.home/private/.gitignore --
*
!*/
!*.age
!.gitignore
!README.md
!recipients.txt
!.gitkeep
-- home/.home/private/identity.age --
placeholder: the scenarios never decrypt
-- home/.home/private/recipients.txt --
age1tujyac0368fyf35ffq75jjm8uu42endd5yx4c9ljlrt8yyhsuu2smhgq2m
-- home/.home/autolink/common/zshrc --
export A=1
-- inbox-clean-first.stdout --
homebot · testhost · nothing needs you. Home is in order.
-- inbox-unsealed.stdout --
homebot · testhost · 2 things need you

  1  • 1 secret not sealed yet
       → homebot lock
  2  • 1 link to make or fix
       → homebot link

  Do the first one now: homebot next
-- inbox-unsealed.stderr --
-- lock.stdout --
sealed private/common/api-token
-- lock.stderr --
-- inbox-after-lock.stdout --
homebot · testhost · 1 thing needs you

  1  • 1 link to make or fix
       → homebot link

  Do the first one now: homebot next
-- lock-again.stdout --
Nothing to seal.
