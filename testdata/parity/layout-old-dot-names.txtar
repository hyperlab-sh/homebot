[!linux] skip 'recorded on linux'

# The old "dot-" spelling is an error that says what to rename it to. link exits 1.
# exit: 1
! exec homebot link
cmpwork stdout layout-old-dot-link.stdout
cmpwork stderr layout-old-dot-link.stderr
# exit: 0
exec homebot link --dry-run
cmpwork stdout layout-old-dot-dry.stdout
# exit: 0
exec homebot
cmpwork stdout layout-old-dot-inbox.stdout
-- home/.home/homebot.yml --
profiles:
  default: workstation
-- home/.home/autolink/common/dot-zshrc --
export A=1
-- home/.home/autolink/common/gitconfig --
[user]
-- home/.home/autolink/linux/dot-profile --
export B=2
-- layout-old-dot-link.stdout --
  link    ~/.gitconfig
  invalid autolink/common/dot-zshrc  "dot-zshrc" is the old layout: rename it to "zshrc"
  invalid autolink/linux/dot-profile  "dot-profile" is the old layout: rename it to "profile"
1 change, 0 already linked, 2 layout errors in the repo
-- layout-old-dot-link.stderr --
-- layout-old-dot-dry.stdout --
  invalid autolink/common/dot-zshrc  "dot-zshrc" is the old layout: rename it to "zshrc"
  invalid autolink/linux/dot-profile  "dot-profile" is the old layout: rename it to "profile"
1 already linked
-- layout-old-dot-inbox.stdout --
homebot · testhost · 5 things need you (2 urgent)

  1  ! ~/.home is not a git repository
       → git -C ~/.home init
  2  ! 2 layout errors in the repo; those parts aren't linked
       "dot-zshrc" is the old layout: rename it to "zshrc"; "dot-profile" is the
       old layout: rename it to "profile"
       → homebot link --dry-run
  3  • Secrets are not set up yet
       → homebot keys init
  4  • Profile workstation does not exist yet
       Write the steps that set up this machine
       → $EDITOR ~/.home/manifests/profiles/workstation.yml
  5  • The background helper is not installed
       It seals, exports, links and reminds you every hour
       → homebot setup
