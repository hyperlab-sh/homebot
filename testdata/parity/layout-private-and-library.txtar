[!linux] skip 'recorded on linux'

# Layout rules in private/ and the NO_DOT name "Library": a sealed secret stays locked until unlocked.
# exit: 0
exec homebot link
cmpwork stdout layout-private-link.stdout
exists home/Library/note
# exit: 0
exec homebot
cmpwork stdout layout-private-inbox.stdout
