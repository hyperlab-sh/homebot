[!linux] skip 'recorded on linux'

# A real unpack with run steps: output order, a failing step and the resume hint, then the fixed run.
# exit: 1
! exec homebot unpack
cmpwork stdout unpack-fails.stdout
cmpwork stderr unpack-fails.stderr
exists home/touched-one
! exists home/touched-three
# exit: 0
exec homebot unpack --from 3
cmpwork stdout unpack-resume.stdout
cmpwork stderr unpack-resume.stderr
# exit: 0
exec homebot
cmpwork stdout inbox-after-resume.stdout
exec cp fixed.yml home/.home/manifests/profiles/workstation.yml
# exit: 0
exec homebot unpack
cmpwork stdout unpack-fixed.stdout
# exit: 0
exec homebot
cmpwork stdout inbox-unpacked.stdout
# exit: 0
exec homebot unpack
cmpwork stdout unpack-twice.stdout
-- home/.home/homebot.yml --
profiles:
  default: workstation
-- home/.home/manifests/profiles/workstation.yml --
steps:
  - run: echo one && touch ../../touched-one
  - run: echo two; exit 7
  - run: echo three && touch ../../touched-three
-- fixed.yml --
steps:
  - run: echo one && touch ../../touched-one
  - run: echo two
  - run: echo three && touch ../../touched-three
-- unpack-fails.stdout --
Unpacking workstation on testhost (linux): 3 steps
[1/3] run echo one && touch ../../touched-one
one
[2/3] run echo two; exit 7
two
-- unpack-fails.stderr --
homebot: Step 2 failed: run: "echo two; exit 7" exited with 7
Fix it, then resume:
  homebot unpack workstation --from 2
-- unpack-resume.stdout --
Unpacking workstation on testhost (linux): 3 steps
[1/3] run echo one && touch ../../touched-one  (skipped)
[2/3] run echo two; exit 7  (skipped)
[3/3] run echo three && touch ../../touched-three
three
Unpacked workstation.
-- unpack-resume.stderr --
-- inbox-after-resume.stdout --
homebot · testhost · 3 things need you (1 urgent)

  1  ! ~/.home is not a git repository
       → git -C ~/.home init
  2  • Secrets are not set up yet
       → homebot keys init
  3  • The background helper is not installed
       It seals, exports, links and reminds you every hour
       → homebot setup
-- unpack-fixed.stdout --
Unpacking workstation on testhost (linux): 3 steps
[1/3] run echo one && touch ../../touched-one
one
[2/3] run echo two
two
[3/3] run echo three && touch ../../touched-three
three
Unpacked workstation.
-- inbox-unpacked.stdout --
homebot · testhost · 3 things need you (1 urgent)

  1  ! ~/.home is not a git repository
       → git -C ~/.home init
  2  • Secrets are not set up yet
       → homebot keys init
