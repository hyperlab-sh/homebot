[!linux] skip 'recorded on linux'

# An option the command does not have: the parse error and the pointer to its help.
# exit: 1
! exec homebot link --nope
cmpwork stdout unknown-flag-link.stdout
cmpwork stderr unknown-flag-link.stderr
# Bare homebot is the inbox, so the pointer is the overview.
# exit: 1
! exec homebot --nope
cmpwork stdout unknown-flag-bare.stdout
cmpwork stderr unknown-flag-bare.stderr
# An option that wants a value.
# exit: 1
! exec homebot save --message
cmpwork stdout unknown-flag-novalue.stdout
cmpwork stderr unknown-flag-novalue.stderr
-- home/.home/homebot.yml --
profiles:
  default: workstation
-- unknown-flag-link.stdout --
-- unknown-flag-link.stderr --
homebot: Unknown option '--nope'. To specify a positional argument starting with a '-', place it at the end of the command after '--', as in '-- "--nope"
See: homebot link --help
-- unknown-flag-bare.stdout --
-- unknown-flag-bare.stderr --
homebot: Unknown option '--nope'. To specify a positional argument starting with a '-', place it at the end of the command after '--', as in '-- "--nope"
See: homebot --help
-- unknown-flag-novalue.stdout --
