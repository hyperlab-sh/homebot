[!linux] skip 'recorded on linux'

# homebot.yml error: unknown nested key
# exit: 1
! exec homebot
cmpwork stdout config-unknown-nested-key.stdout
# deliberate: PARITY.md "homebot.yml (Task 1)": config errors name the line and column, and a nested unknown key reads unknown key "x" under profiles (...)
cmpwork stderr config-unknown-nested-key.stderr
-- home/.home/homebot.yml --
profiles:
  default: workstation
  hostz:
    laptop: workstation
-- config-unknown-nested-key.stdout --
-- config-unknown-nested-key.stderr --
homebot: $WORK/home/.home/homebot.yml:3:3: unknown key "hostz" under profiles (expected default, hosts)
