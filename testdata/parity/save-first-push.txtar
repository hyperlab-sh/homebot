[!linux] skip 'recorded on linux'

# origin exists but nothing was pushed: save pushes with -u.
exec git -C home/.home init -q
exec git -C home/.home add -A
exec git -C home/.home commit -q -m init
exec git init -q --bare remote.git
exec git -C home/.home remote add origin $WORK/remote.git
# exit: 0
exec homebot
cmpwork stdout inbox-before.stdout
# exit: 0
exec homebot save
cmpwork stdout save-first-push.stdout
cmpwork stderr save-first-push.stderr
exec git -C home/.home rev-parse --abbrev-ref @{u}
cmpwork stdout upstream.stdout
-- bin/gitleaks --
#!/bin/sh
exit 0
-- bin/systemctl --
#!/bin/sh
exit 0
-- home/.home/homebot.yml --
profiles:
  default: workstation
-- home/.home/manifests/profiles/workstation.yml --
description: A workstation
steps:
  - link
-- home/.home/private/.gitignore --
*
!*/
!*.age
!.gitignore
!README.md
!recipients.txt
!.gitkeep
-- home/.home/private/identity.age --
placeholder: the scenarios never decrypt
