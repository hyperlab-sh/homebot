[!linux] skip 'recorded on linux'

# link makes the links; the second link has nothing to do. unlink removes them.
# exit: 0
exec homebot link
cmpwork stdout link-first.stdout
cmpwork stderr link-first.stderr
exists home/.zshrc
# exit: 0
exec homebot link
cmpwork stdout link-second.stdout
# exit: 0
exec homebot link --dry-run
cmpwork stdout link-dry-after.stdout
# exit: 0
exec homebot unlink
cmpwork stdout unlink.stdout
! exists home/.zshrc
-- home/.home/homebot.yml --
profiles:
  default: workstation
-- home/.home/autolink/common/zshrc --
export A=1
-- home/.home/autolink/common/gitconfig --
[user]
-- home/.home/autolink/common/tmux/tmux.conf --
set -g mouse on
-- link-first.stdout --
  link    ~/.gitconfig
  link    ~/.tmux
  link    ~/.zshrc
3 changes, 0 already linked
-- link-first.stderr --
-- link-second.stdout --
0 changes, 3 already linked
-- link-dry-after.stdout --
3 already linked
-- unlink.stdout --
Removed 3 links. To put them back:
  homebot link
