# The age CLI and homebot read each other's files (plan 4, "age: library"):
# what homebot seals the CLI opens, and what the CLI seals homebot opens.
# homebot runs as a test binary here, so HOMEBOT_TEST_PASSPHRASE answers its
# passphrase prompts; the CLI gets the same passphrase through
# age-plugin-batchpass.
[!exec:age] skip 'needs the age CLI'
[!exec:age-keygen] skip 'needs age-keygen'
[!exec:age-plugin-batchpass] skip 'needs age-plugin-batchpass'

env PRIVATE=$WORK/home/.home/private
env HOMEBOT_TEST_PASSPHRASE='an interop passphrase'
env HOMEBOT_TEST_SCRYPT_WORK_FACTOR=10
env AGE_PASSPHRASE='an interop passphrase'

# keys init seals the private key with the passphrase, in age-keygen's
# layout, and writes the public key that goes with it.
exec homebot keys init
stdout '^  age1[a-z0-9]{58}$'
exec age -d -j batchpass -o key.txt $PRIVATE/identity.age
grep '^# created: 2026-01-01T00:00:00Z$' key.txt
grep '^# public key: age1[a-z0-9]{58}$' key.txt
grep '^AGE-SECRET-KEY-1[A-Z0-9]{58}$' key.txt
exec age-keygen -y key.txt
cmp stdout $PRIVATE/recipients.txt

# What homebot seals, the CLI opens with the private key.
cp netrc $PRIVATE/common/netrc
cp blob.bin $PRIVATE/linux/blob
exec homebot lock
stdout '^sealed private/common/netrc, private/linux/blob$'
exec age -d -i key.txt $PRIVATE/common/netrc.age
cmp stdout netrc
exec age -d -i key.txt -o blob.out $PRIVATE/linux/blob.age
cmp blob.out blob.bin

# What the CLI seals to recipients.txt, homebot opens.
exec age -R $PRIVATE/recipients.txt -o $PRIVATE/linux/token.age token
exec homebot unlock
stdout '^unlocked 1 secret$'
cmp $PRIVATE/linux/token token

# A private key the CLI made and sealed with a passphrase works in homebot,
# both ways.
rm $PRIVATE/identity.age $PRIVATE/recipients.txt $PRIVATE/common $PRIVATE/linux
mkdir $PRIVATE/common
exec age-keygen -o cli-key.txt
env AGE_PASSPHRASE_WORK_FACTOR=10
exec age -e -j batchpass -o $PRIVATE/identity.age cli-key.txt
exec age-keygen -y -o $PRIVATE/recipients.txt cli-key.txt
exec age -R $PRIVATE/recipients.txt -o $PRIVATE/common/from-cli.age token
exec homebot unlock
stdout '^unlocked 1 secret$'
cmp $PRIVATE/common/from-cli token
cp netrc $PRIVATE/common/from-homebot
exec homebot lock
stdout '^sealed private/common/from-homebot$'
exec age -d -i cli-key.txt $PRIVATE/common/from-homebot.age
cmp stdout netrc

# Another passphrase does not open it.
env HOMEBOT_TEST_PASSPHRASE='not the passphrase'
rm $PRIVATE/common/from-cli
! exec homebot unlock
stderr '^homebot: Could not decrypt private/identity.age \(wrong passphrase\?\)$'
! exists $PRIVATE/common/from-cli

-- home/.home/homebot.yml --
profiles:
  default: workstation
-- home/.home/manifests/profiles/workstation.yml --
description: A workstation
steps:
  - link
-- home/.home/private/.gitignore --
*
!*/
!*.age
!.gitignore
!README.md
!recipients.txt
!.gitkeep
-- home/.home/private/common/.gitkeep --
-- home/.home/private/linux/.gitkeep --
-- netrc --
machine example.com login me password interop-netrc
-- token --
ghp_interop_token
-- blob.bin --
binary	bytes stay put
