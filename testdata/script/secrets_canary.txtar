# A secret's plaintext never leaves private/ (plan 8.4, secret canary): not
# through stdout or stderr, not into state, cache, temp files or anything
# else under $WORK. The private key and the passphrase appear nowhere at all.
# Debug logging is on, so it is checked too. Each OS layer holds a token,
# so whichever OS runs the test links two secrets: common's and its own.
env HOMEBOT_DEBUG=1
env HOMEBOT_TEST_PASSPHRASE='a passphrase 5d0c7e41'
env HOMEBOT_TEST_SCRYPT_WORK_FACTOR=10
env PRIVATE=$WORK/home/.home/private

exec homebot keys init
! stdout 'canary-|AGE-SECRET-KEY|5d0c7e41'
! stderr 'canary-|AGE-SECRET-KEY|5d0c7e41'

exec homebot lock
stdout '^sealed private/common/netrc, private/linux/token, private/macos/token$'
! stdout 'canary-|AGE-SECRET-KEY|5d0c7e41'
! stderr 'canary-|AGE-SECRET-KEY|5d0c7e41'

exec homebot lock --wipe
! stdout 'canary-|AGE-SECRET-KEY|5d0c7e41'
! stderr 'canary-|AGE-SECRET-KEY|5d0c7e41'
! exists $PRIVATE/common/netrc

exec homebot unlock
stdout '^unlocked 3 secrets$'
stdout '^linked 2 secrets$'
! stdout 'canary-|AGE-SECRET-KEY|5d0c7e41'
! stderr 'canary-|AGE-SECRET-KEY|5d0c7e41'
grep 'canary-7f3e9b2d' $PRIVATE/common/netrc
# $HOME gets links to the plaintext, never a copy.
exec test -L $WORK/home/.netrc
exec test -L $WORK/home/.token

# A conflict: no record of the plaintext, which was edited here.
rm $WORK/xdg/state
exec sh -c 'echo canary-local-0b8a61 > "$PRIVATE/linux/token"'
exec homebot unlock
stdout '^conflict private/linux/token: '
! stdout 'canary-|AGE-SECRET-KEY|5d0c7e41'
! stderr 'canary-|AGE-SECRET-KEY|5d0c7e41'
exec homebot lock --ours
stdout '^sealed private/linux/token$'
! stdout 'canary-|AGE-SECRET-KEY|5d0c7e41'
! stderr 'canary-|AGE-SECRET-KEY|5d0c7e41'
rm $PRIVATE/linux/token
exec homebot unlock
stdout '^unlocked 1 secret$'
! stdout 'canary-|AGE-SECRET-KEY|5d0c7e41'
! stderr 'canary-|AGE-SECRET-KEY|5d0c7e41'
grep 'canary-local-0b8a61' $PRIVATE/linux/token

# Nothing outside $PRIVATE holds a planted value, not even a folder named
# private elsewhere; nothing anywhere holds the private key or the
# passphrase. The searches print what holds one, and complain on stderr
# about what they could not read. Links are not followed.
exec sh -c 'find "$WORK" -path "$PRIVATE" -prune -o -type f -exec grep -lE "canary-" {} + || true'
! stdout .
! stderr .
exec sh -c 'grep -rlE "AGE-SECRET-KEY|5d0c7e41" "$WORK" || true'
! stdout .
! stderr .
# The first search does look everywhere but $PRIVATE.
exec sh -c 'find "$WORK" -path "$PRIVATE" -prune -o -type f -exec grep -lE "^profiles:|canary-" {} +'
stdout '/home/\.home/homebot\.yml$'
stdout '/home/\.home/elsewhere/private/notes$'
! stdout '/home/\.home/private/'
exec sh -c 'grep -rlE "canary-" "$PRIVATE"'
stdout '/private/common/netrc$'

-- home/.home/homebot.yml --
profiles:
  default: workstation
-- home/.home/manifests/profiles/workstation.yml --
description: A workstation
steps:
  - link
-- home/.home/private/.gitignore --
*
!*/
!*.age
!.gitignore
!README.md
!recipients.txt
!.gitkeep
-- home/.home/elsewhere/private/notes --
profiles: a folder named private outside the secrets
-- home/.home/private/common/netrc --
machine example.com login me password canary-7f3e9b2d
-- home/.home/private/linux/token --
canary-token-c41e09
-- home/.home/private/macos/token --
canary-token-mac-9d27f4
